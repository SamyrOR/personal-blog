---
import "@pagefind/default-ui/css/ui.css";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@config";
import { LANGUAGES_KEYS } from "i18n/utils";
import { useTranslations } from "i18n";

export const getStaticPaths = () =>
  LANGUAGES_KEYS.map(lang => ({ params: { lang } }));

const { lang } = Astro.params;
const t = useTranslations(lang);
---

<Layout {lang} title={`${t.pages.searchTitle} | ${SITE.title}`}>
  <Header activeNav="search" {lang} />
  <Main pageTitle={t.pages.searchTitle} pageDesc={t.pages.searchDesc} {lang}>
    <div id="pagefind-search" data-bundle-path="/pagefind/"></div>
  </Main>
  <Footer {lang} />
</Layout>

<script>
  function initSearch() {
    const pageFindSearch: HTMLElement | null =
      document.querySelector("#pagefind-search");

    if (!pageFindSearch) return;

    const bundlePath = pageFindSearch?.dataset?.bundlePath;
    if (!bundlePath) return;

    const onIdle = window.requestIdleCallback || (cb => setTimeout(cb, 1));

    onIdle(async () => {
      // @ts-expect-error — Missing types for @pagefind/default-ui package.
      const { PagefindUI } = await import("@pagefind/default-ui");

      // Pagefind only has a search index once the site has been built at
      // least once - the dev server serves unbuilt source, so there's
      // nothing for it to query yet.
      if (import.meta.env.DEV) {
        pageFindSearch.innerHTML = `
            <div class="rounded border border-skin-line bg-skin-card/75 p-4">
              <p><strong>Dev mode:</strong> you need to build the project at least once to see search results locally.</p>
              <code class="mt-2 block rounded bg-skin-fill px-2 py-1">npm run build</code>
            </div>
          `;
      }

      new PagefindUI({
        element: "#pagefind-search",
        bundlePath,
        showImages: false,
        showSubResults: true,
      });
    });
  }

  document.addEventListener("astro:page-load", initSearch);
</script>
